{{- /*
  sing-box 1.14 订阅模板（PerfectPanel）
  适用: sing-box 1.14.x（1.13 请用 sing-box-1.13.gotmpl）
  说明:
    - 使用 1.14 新配置: store_dns、显式 http_clients + route.default_http_client
      （替代已弃用的 rule_set.download_detour / independent_cache / store_rdrc），无弃用告警。
      注意: 默认 http_client 不要写 detour 指向纯 direct 出站——1.14 会拒绝
      "detour to an empty direct outbound"；不写 detour 客户端即自行直连拨号，效果相同。
    - outbound 全部用 dict+toJson 生成，节点名含引号/反斜杠不会破坏 JSON。
    - 协议覆盖: shadowsocks(含 2022/obfs/v2ray-plugin/shadow-tls 链式)、vmess、
      vless(reality/vision)、trojan、hysteria2(端口跳跃/salamander)、tuic、anytls、
      snell(v5/v6, 1.14 新增)、naive(需客户端带 with_naive_outbound 构建,
      官方 GUI 客户端默认包含; 纯 CLI 精简构建会拒绝该配置)。
      跳过: ssr/mieru(sing-box 不支持)、
      xhttp 传输与 vless ML-KEM 加密节点、restls/kcptun 插件节点。
*/ -}}
{{- $GiB := 1073741824.0 -}}
{{- $used := printf "%.2f" (divf (add (.UserInfo.Download | default 0 | float64) (.UserInfo.Upload | default 0 | float64)) $GiB) -}}
{{- $traffic := (.UserInfo.Traffic | default 0 | float64) -}}
{{- $total := printf "%.2f" (divf $traffic $GiB) -}}

{{- $ExpiredAt := "" -}}
{{- $expStr := printf "%v" .UserInfo.ExpiredAt -}}
{{- if regexMatch `^[0-9]+$` $expStr -}}
  {{- $ts := $expStr | float64 -}}
  {{- $sec := ternary (divf $ts 1000.0) $ts (ge (len $expStr) 13) -}}
  {{- $ExpiredAt = (date "2006-01-02 15:04:05" (unixEpoch ($sec | int64))) -}}
{{- else -}}
  {{- $ExpiredAt = $expStr -}}
{{- end -}}

{{- /* ---- 排序: Sort / Port / Name 升序 ---- */ -}}
{{- $byKey := dict -}}
{{- range $p := .Proxies -}}
  {{- $keyParts := list -}}
  {{- range $field := list "Sort" "Port" "Name" -}}
    {{- $val := default "" (printf "%v" (index $p $field)) -}}
    {{- if or (eq $field "Sort") (eq $field "Port") -}}
      {{- $val = printf "%08d" (int (default 0 (index $p $field))) -}}
    {{- end -}}
    {{- $keyParts = append $keyParts $val -}}
  {{- end -}}
  {{- $_ := set $byKey (join "|" $keyParts) $p -}}
{{- end -}}
{{- $sorted := list -}}
{{- range $k := sortAlpha (keys $byKey) -}}
  {{- $sorted = append $sorted (index $byKey $k) -}}
{{- end -}}

{{- /* ---- 过滤 sing-box 1.14 可用节点, 并按 tag 去重 ---- */ -}}
{{- $reserved := dict "总模式" true "ALL·延迟最低" true "ALL·其它地区" true "直连" true "ALL·日本地区" true "ALL·中国台湾" true "ALL·香港地区" true "ALL·美国地区" true "ALL·狮城地区" true "小红书" true "抖音" true "BiliBili" true "Steam" true "游戏平台" true "Apple" true "Microsoft" true "Telegram" true "Discord" true "Spotify" true "TikTok" true "YouTube" true "Netflix" true "Disney+" true "海外媒体" true "巴哈姆特" true "Google" true "GoogleFCM" true "Facebook" true "AI" true "GitHub" true "Twitter(X)" true "PayPal" true "加密货币" true "Speedtest" true "漏网之鱼" true -}}
{{- $seen := dict -}}
{{- $supported := list -}}
{{- range $p := $sorted -}}
  {{- $t := lower (default "" $p.Type) -}}
  {{- $tr := lower (default "" $p.Transport) -}}
  {{- $ok := false -}}
  {{- if or (eq $t "hysteria") (eq $t "hysteria2") (eq $t "hy2") (eq $t "tuic") (eq $t "anytls") (eq $t "snell") (eq $t "naive") -}}
    {{- $ok = true -}}
  {{- else if or (eq $t "vmess") (eq $t "trojan") -}}
    {{- $ok = (ne $tr "xhttp") -}}
  {{- else if eq $t "vless" -}}
    {{- $enc := lower (default "" $p.Encryption) -}}
    {{- $ok = and (or (eq $enc "") (eq $enc "none")) (ne $tr "xhttp") -}}
  {{- else if eq $t "shadowsocks" -}}
    {{- $plugin := lower (default "" $p.Plugin) -}}
    {{- $ok = or (eq $plugin "") (eq $plugin "obfs") (eq $plugin "v2ray-plugin") (eq $plugin "shadow-tls") -}}
  {{- end -}}
  {{- if and $ok (not (hasKey $seen $p.Name)) (not (hasKey $reserved $p.Name)) -}}
    {{- $_ := set $seen $p.Name true -}}
    {{- $supported = append $supported $p -}}
  {{- end -}}
{{- end -}}

{{- /* ---- 生成节点 outbound ---- */ -}}
{{- $pwd := .UserInfo.Password -}}
{{- $nodeOutbounds := list -}}
{{- $names := list -}}
{{- range $p := $supported -}}
  {{- $t := lower $p.Type -}}
  {{- $tr := lower (default "" $p.Transport) -}}
  {{- $sec := lower (default "" $p.Security) -}}
  {{- $server := trimAll "[]" $p.Server -}}
  {{- $isQuic := or (eq $t "hysteria") (eq $t "hysteria2") (eq $t "hy2") (eq $t "tuic") -}}

  {{- /* TLS: QUIC 系协议强制启用; 其余按 security 判断 */ -}}
  {{- $tls := dict -}}
  {{- if or $isQuic (eq $sec "tls") (eq $sec "reality") -}}
    {{- $tls = dict "enabled" true -}}
    {{- if $p.SNI -}}{{- $_ := set $tls "server_name" $p.SNI -}}{{- end -}}
    {{- /* 写死跳过证书校验(含自签名/证书哈希 pin 场景, sing-box 不支持证书哈希 pin) */ -}}
    {{- $_ := set $tls "insecure" true -}}
    {{- if gt (len $p.ALPN) 0 -}}{{- $_ := set $tls "alpn" $p.ALPN -}}{{- end -}}
    {{- if $p.EchEnable -}}
      {{- $ech := dict "enabled" true -}}
      {{- if $p.EchServerName -}}{{- $_ := set $ech "query_server_name" $p.EchServerName -}}{{- end -}}
      {{- $_ := set $tls "ech" $ech -}}
    {{- end -}}
    {{- if eq $sec "reality" -}}
      {{- $reality := dict "enabled" true "public_key" (default "" $p.RealityPublicKey) -}}
      {{- if $p.RealityShortId -}}{{- $_ := set $reality "short_id" $p.RealityShortId -}}{{- end -}}
      {{- $_ := set $tls "reality" $reality -}}
      {{- $_ := set $tls "utls" (dict "enabled" true "fingerprint" (default "chrome" $p.Fingerprint)) -}}
    {{- /* naive 由 cronet(Chromium 网络栈)处理 TLS, 不适用 uTLS */ -}}
    {{- else if and $p.Fingerprint (not $isQuic) (ne $t "naive") -}}
      {{- $_ := set $tls "utls" (dict "enabled" true "fingerprint" $p.Fingerprint) -}}
    {{- end -}}
  {{- end -}}

  {{- /* v2ray 传输层 (vmess/vless/trojan) */ -}}
  {{- $transport := dict -}}
  {{- if or (eq $tr "ws") (eq $tr "websocket") -}}
    {{- $transport = dict "type" "ws" "path" (default "/" $p.Path) -}}
    {{- if $p.Host -}}{{- $_ := set $transport "headers" (dict "Host" $p.Host) -}}{{- end -}}
  {{- else if eq $tr "grpc" -}}
    {{- $transport = dict "type" "grpc" "service_name" (default "grpc" $p.ServiceName) -}}
  {{- else if eq $tr "httpupgrade" -}}
    {{- $transport = dict "type" "httpupgrade" "path" (default "/" $p.Path) -}}
    {{- if $p.Host -}}{{- $_ := set $transport "host" $p.Host -}}{{- end -}}
  {{- end -}}

  {{- /* sing-box 多路复用 */ -}}
  {{- $mux := dict -}}
  {{- $muxProto := lower (default "" $p.Multiplex) -}}
  {{- if or (eq $muxProto "smux") (eq $muxProto "yamux") (eq $muxProto "h2mux") -}}
    {{- $mux = dict "enabled" true "protocol" $muxProto -}}
  {{- end -}}

  {{- $out := dict "tag" $p.Name "server" $server "server_port" $p.Port -}}

  {{- if eq $t "shadowsocks" -}}
    {{- $_ := set $out "type" "shadowsocks" -}}
    {{- $_ := set $out "method" (default "aes-128-gcm" $p.Method) -}}
    {{- $password := $pwd -}}
    {{- if $p.ServerKey -}}
      {{- $needBytes := ternary 16 32 (eq $p.Method "2022-blake3-aes-128-gcm") -}}
      {{- $cutLen := min $needBytes (len $pwd) | int -}}
      {{- $password = printf "%s:%s" (b64enc $p.ServerKey) (b64enc ($pwd | trunc $cutLen)) -}}
    {{- end -}}
    {{- $_ := set $out "password" $password -}}
    {{- $plugin := lower (default "" $p.Plugin) -}}
    {{- $popts := default dict $p.PluginOptions -}}
    {{- if eq $plugin "obfs" -}}
      {{- $_ := set $out "plugin" "obfs-local" -}}
      {{- $opts := printf "obfs=%s" (default "http" (index $popts "mode")) -}}
      {{- if index $popts "host" -}}{{- $opts = printf "%s;obfs-host=%s" $opts (index $popts "host") -}}{{- end -}}
      {{- $_ := set $out "plugin_opts" $opts -}}
    {{- else if eq $plugin "v2ray-plugin" -}}
      {{- $_ := set $out "plugin" "v2ray-plugin" -}}
      {{- $opts := "mode=websocket" -}}
      {{- if index $popts "host" -}}{{- $opts = printf "%s;host=%s" $opts (index $popts "host") -}}{{- end -}}
      {{- if index $popts "path" -}}{{- $opts = printf "%s;path=%s" $opts (index $popts "path") -}}{{- end -}}
      {{- if index $popts "tls" -}}{{- $opts = printf "%s;tls" $opts -}}{{- end -}}
      {{- $_ := set $out "plugin_opts" $opts -}}
    {{- else if eq $plugin "shadow-tls" -}}
      {{- /* sing-box 以独立 shadowtls outbound + ss detour 链式实现, 而非 ss 插件 */ -}}
      {{- $stTag := printf "%s-shadowtls" $p.Name -}}
      {{- $stTLS := dict "enabled" true "insecure" true -}}
      {{- if index $popts "host" -}}{{- $_ := set $stTLS "server_name" (index $popts "host") -}}{{- end -}}
      {{- if index $popts "alpn" -}}{{- $_ := set $stTLS "alpn" (index $popts "alpn") -}}{{- end -}}
      {{- if index $popts "fingerprint" -}}
        {{- $_ := set $stTLS "utls" (dict "enabled" true "fingerprint" (index $popts "fingerprint")) -}}
      {{- end -}}
      {{- $st := dict "type" "shadowtls" "tag" $stTag "server" $server "server_port" $p.Port "version" (int (default 2 (index $popts "version"))) "tls" $stTLS -}}
      {{- if index $popts "password" -}}{{- $_ := set $st "password" (index $popts "password") -}}{{- end -}}
      {{- $nodeOutbounds = append $nodeOutbounds $st -}}
      {{- $_ := set $out "detour" $stTag -}}
      {{- /* shadowtls 为纯 TCP 链路, UDP 依赖 UoT */ -}}
      {{- $_ := set $out "udp_over_tcp" true -}}
    {{- end -}}
    {{- if $p.UoT -}}
      {{- $uot := dict "enabled" true -}}
      {{- if $p.UoTVersion -}}{{- $_ := set $uot "version" $p.UoTVersion -}}{{- end -}}
      {{- $_ := set $out "udp_over_tcp" $uot -}}
    {{- end -}}
    {{- if $mux.enabled -}}{{- $_ := set $out "multiplex" $mux -}}{{- end -}}

  {{- else if eq $t "vmess" -}}
    {{- $_ := set $out "type" "vmess" -}}
    {{- $_ := set $out "uuid" $pwd -}}
    {{- $_ := set $out "security" "auto" -}}
    {{- if $transport.type -}}{{- $_ := set $out "transport" $transport -}}{{- end -}}
    {{- if $tls.enabled -}}{{- $_ := set $out "tls" $tls -}}{{- end -}}
    {{- if $mux.enabled -}}{{- $_ := set $out "multiplex" $mux -}}{{- end -}}

  {{- else if eq $t "vless" -}}
    {{- $_ := set $out "type" "vless" -}}
    {{- $_ := set $out "uuid" $pwd -}}
    {{- if $p.Flow -}}{{- $_ := set $out "flow" $p.Flow -}}{{- end -}}
    {{- if $transport.type -}}{{- $_ := set $out "transport" $transport -}}{{- end -}}
    {{- if $tls.enabled -}}{{- $_ := set $out "tls" $tls -}}{{- end -}}
    {{- /* vision flow 与 multiplex 互斥 */ -}}
    {{- if and $mux.enabled (not $p.Flow) -}}{{- $_ := set $out "multiplex" $mux -}}{{- end -}}

  {{- else if eq $t "trojan" -}}
    {{- $_ := set $out "type" "trojan" -}}
    {{- $_ := set $out "password" $pwd -}}
    {{- if $transport.type -}}{{- $_ := set $out "transport" $transport -}}{{- end -}}
    {{- if $tls.enabled -}}{{- $_ := set $out "tls" $tls -}}{{- end -}}
    {{- if $mux.enabled -}}{{- $_ := set $out "multiplex" $mux -}}{{- end -}}

  {{- else if or (eq $t "hysteria") (eq $t "hysteria2") (eq $t "hy2") -}}
    {{- $_ := set $out "type" "hysteria2" -}}
    {{- $_ := set $out "password" $pwd -}}
    {{- if $p.ObfsPassword -}}
      {{- $_ := set $out "obfs" (dict "type" "salamander" "password" $p.ObfsPassword) -}}
    {{- end -}}
    {{- if $p.HopPorts -}}
      {{- $ports := list -}}
      {{- range $seg := splitList "," $p.HopPorts -}}
        {{- $seg = trim $seg -}}
        {{- if $seg -}}
          {{- /* sing-box server_ports 只接受 "起:止" 区间, 单端口需展开为 N:N */ -}}
          {{- if contains "-" $seg -}}
            {{- $ports = append $ports (replace "-" ":" $seg) -}}
          {{- else -}}
            {{- $ports = append $ports (printf "%s:%s" $seg $seg) -}}
          {{- end -}}
        {{- end -}}
      {{- end -}}
      {{- if gt (len $ports) 0 -}}
        {{- $_ := set $out "server_ports" $ports -}}
        {{- if $p.HopInterval -}}{{- $_ := set $out "hop_interval" (printf "%ds" (int $p.HopInterval)) -}}{{- end -}}
      {{- end -}}
    {{- end -}}
    {{- if $p.UpMbps -}}{{- $_ := set $out "up_mbps" $p.UpMbps -}}{{- end -}}
    {{- if $p.DownMbps -}}{{- $_ := set $out "down_mbps" $p.DownMbps -}}{{- end -}}
    {{- $_ := set $out "tls" $tls -}}

  {{- else if eq $t "tuic" -}}
    {{- $_ := set $out "type" "tuic" -}}
    {{- $_ := set $out "uuid" (default "" $p.ServerKey) -}}
    {{- $_ := set $out "password" $pwd -}}
    {{- if $p.CongestionController -}}{{- $_ := set $out "congestion_control" $p.CongestionController -}}{{- end -}}
    {{- if $p.UDPRelayMode -}}{{- $_ := set $out "udp_relay_mode" $p.UDPRelayMode -}}{{- end -}}
    {{- if $p.ReduceRtt -}}{{- $_ := set $out "zero_rtt_handshake" true -}}{{- end -}}
    {{- if $p.Heartbeat -}}{{- $_ := set $out "heartbeat" (printf "%ds" (int $p.Heartbeat)) -}}{{- end -}}
    {{- if $p.DisableSNI -}}{{- $_ := set $tls "disable_sni" true -}}{{- end -}}
    {{- if not $tls.alpn -}}{{- $_ := set $tls "alpn" (list "h3") -}}{{- end -}}
    {{- $_ := set $out "tls" $tls -}}

  {{- else if eq $t "anytls" -}}
    {{- $_ := set $out "type" "anytls" -}}
    {{- $_ := set $out "password" $pwd -}}
    {{- $_ := set $out "tls" $tls -}}

  {{- else if eq $t "naive" -}}
    {{- $_ := set $out "type" "naive" -}}
    {{- $_ := set $out "username" (printf "%v" $.UserInfo.ID) -}}
    {{- $_ := set $out "password" $pwd -}}
    {{- /* 写死 UoT: 无它 naive 不代理 UDP; 节点端为 sing-box naive inbound, 原生解 UoT */ -}}
    {{- $_ := set $out "udp_over_tcp" true -}}
    {{- /* 面板 Network=udp 表示 QUIC(h3) 监听, 否则走 TCP(h2) */ -}}
    {{- $net := lower (default "" $p.Network) -}}
    {{- if or (eq $net "udp") (eq $net "quic") -}}
      {{- $_ := set $out "quic" true -}}
      {{- if $p.QUICCongestionControl -}}{{- $_ := set $out "quic_congestion_control" $p.QUICCongestionControl -}}{{- end -}}
    {{- end -}}
    {{- /* naive 显式拒绝 insecure/alpn/utls/disable_sni 等 TLS 选项(cronet 始终真实校验证书),
           只能给最小 TLS 块; 自签证书的 naive 节点在 sing-box 上无法使用 */ -}}
    {{- $naiveTLS := dict "enabled" true -}}
    {{- if $p.SNI -}}{{- $_ := set $naiveTLS "server_name" $p.SNI -}}{{- end -}}
    {{- if $tls.ech -}}{{- $_ := set $naiveTLS "ech" $tls.ech -}}{{- end -}}
    {{- $_ := set $out "tls" $naiveTLS -}}

  {{- else if eq $t "snell" -}}
    {{- /* 面板约定: 每个用户以自己的 UUID 作为 PSK; v5 的 TCP 线协议即 v4 客户端 */ -}}
    {{- $_ := set $out "type" "snell" -}}
    {{- $_ := set $out "psk" $pwd -}}
    {{- if eq (int (default 0 $p.Version)) 6 -}}
      {{- $_ := set $out "version" 6 -}}
      {{- if $p.Mode -}}{{- $_ := set $out "mode" $p.Mode -}}{{- end -}}
    {{- else -}}
      {{- $_ := set $out "version" 4 -}}
      {{- if $p.Obfs -}}
        {{- $_ := set $out "obfs_mode" $p.Obfs -}}
        {{- if $p.ObfsHost -}}{{- $_ := set $out "obfs_host" $p.ObfsHost -}}{{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}

  {{- $nodeOutbounds = append $nodeOutbounds $out -}}
  {{- $names = append $names $p.Name -}}
{{- end -}}

{{- /* ---- 策略组: 总模式 → 自动/地区组 → 直连 → 全部节点; 地区按节点名匹配, 无节点的地区不生成 ---- */ -}}
{{- $hasNodes := gt (len $names) 0 -}}
{{- $regionDefs := list
  (dict "name" "ALL·日本地区" "re" `(?i)(日本|川日|东京|大阪|泉日|埼玉|沪日|深日|[^-]日|jp|japan)`)
  (dict "name" "ALL·中国台湾" "re" `(?i)(台|新北|彰化|tw|taiwan|taipei)`)
  (dict "name" "ALL·香港地区" "re" `(?i)(港|hk|hong ?kong)`)
  (dict "name" "ALL·美国地区" "re" `(?i)(美|波特兰|达拉斯|俄勒冈|凤凰城|费利蒙|硅谷|拉斯维加斯|洛杉矶|圣何塞|圣克拉拉|西雅图|芝加哥|us|united ?states)`)
  (dict "name" "ALL·狮城地区" "re" `(?i)(新加坡|坡|狮城|sg|singapore)`)
-}}
{{- $matched := dict -}}
{{- $regionGroups := list -}}
{{- range $r := $regionDefs -}}
  {{- $members := list -}}
  {{- range $n := $names -}}
    {{- if regexMatch $r.re $n -}}
      {{- $members = append $members $n -}}
      {{- $_ := set $matched $n true -}}
    {{- end -}}
  {{- end -}}
  {{- if $members -}}
    {{- $regionGroups = append $regionGroups (dict "tag" $r.name "type" "urltest" "outbounds" $members "interval" "5m") -}}
  {{- end -}}
{{- end -}}
{{- $others := list -}}
{{- range $n := $names -}}
  {{- if not (hasKey $matched $n) -}}{{- $others = append $others $n -}}{{- end -}}
{{- end -}}
{{- if $others -}}
  {{- $regionGroups = append $regionGroups (dict "tag" "ALL·其它地区" "type" "urltest" "outbounds" $others "interval" "5m") -}}
{{- end -}}
{{- $autoTags := list -}}
{{- if $hasNodes -}}{{- $autoTags = list "ALL·延迟最低" -}}{{- end -}}
{{- range $g := $regionGroups -}}{{- $autoTags = append $autoTags $g.tag -}}{{- end -}}
{{- $selectList := concat (list "总模式") $autoTags (list "直连") $names -}}

{{- $serviceDefs := list
  (dict "name" "小红书" "prefer" "直连")
  (dict "name" "抖音" "prefer" "直连")
  (dict "name" "BiliBili" "prefer" "直连")
  (dict "name" "Steam")
  (dict "name" "游戏平台")
  (dict "name" "Apple")
  (dict "name" "Microsoft")
  (dict "name" "Telegram")
  (dict "name" "Discord")
  (dict "name" "Spotify")
  (dict "name" "TikTok")
  (dict "name" "YouTube")
  (dict "name" "Netflix")
  (dict "name" "Disney+")
  (dict "name" "海外媒体")
  (dict "name" "巴哈姆特" "prefer" "ALL·中国台湾")
  (dict "name" "Google")
  (dict "name" "GoogleFCM")
  (dict "name" "Facebook")
  (dict "name" "AI")
  (dict "name" "GitHub")
  (dict "name" "Twitter(X)")
  (dict "name" "PayPal")
  (dict "name" "加密货币" "prefer" "ALL·中国台湾")
  (dict "name" "Speedtest")
  (dict "name" "漏网之鱼")
-}}
{{- $groups := list (dict "tag" "总模式" "type" "selector" "outbounds" (concat $autoTags (list "直连"))) -}}
{{- range $g := $serviceDefs -}}
  {{- $sel := dict "tag" $g.name "type" "selector" "outbounds" $selectList -}}
  {{- if and (hasKey $g "prefer") (has $g.prefer $selectList) -}}
    {{- $_ := set $sel "default" $g.prefer -}}
  {{- end -}}
  {{- $groups = append $groups $sel -}}
{{- end -}}
{{- if $hasNodes -}}
  {{- $groups = append $groups (dict "tag" "ALL·延迟最低" "type" "urltest" "outbounds" $names "interval" "5m") -}}
{{- end -}}
{{- $allOutbounds := concat $groups $regionGroups $nodeOutbounds (list (dict "tag" "直连" "type" "direct")) -}}

{{- /* ---- 规则集: MetaCubeX meta-rules-dat (sing 分支) + AWAvenue 去广告 ---- */ -}}
{{- $sb := "https://cdn.jsdmirror.com/gh/MetaCubeX/meta-rules-dat@sing" -}}
{{- $ruleSets := list (dict "tag" "ads" "type" "remote" "format" "source" "url" "https://cdn.jsdmirror.com/gh/TG-Twilight/AWAvenue-Ads-Rule@main/Filters/AWAvenue-Ads-Rule-Singbox.json") -}}
{{- range $n := list "private" "googlefcm" "youtube" "google" "douyin" "xiaohongshu" "bilibili" "steam@cn" "category-games@cn" "steam" "category-games-!cn" "github" "discord" "tiktok" "twitter" "netflix" "disney" "hbo" "primevideo" "bahamut" "spotify" "facebook" "category-ai-!cn" "paypal" "category-cryptocurrency" "category-speedtest@cn" "category-speedtest" "apple@cn" "microsoft@cn" "apple" "microsoft" "telegram" "geolocation-!cn" "cn" -}}
  {{- $ruleSets = append $ruleSets (dict "tag" (print "geosite-" $n) "type" "remote" "format" "binary" "url" (print $sb "/geo/geosite/" $n ".srs")) -}}
{{- end -}}
{{- range $n := list "google" "bilibili" "twitter" "netflix" "facebook" "apple" "telegram" "cn" -}}
  {{- $ruleSets = append $ruleSets (dict "tag" (print "geoip-" $n) "type" "remote" "format" "binary" "url" (print $sb "/geo-lite/geoip/" $n ".srs")) -}}
{{- end -}}
// {{ .SiteName }} - {{ .SubscribeName }} | 已用 {{ $used }} GiB / 共 {{ $total }} GiB | 到期: {{ $ExpiredAt }}
// 适用 sing-box 1.14.x
{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "level": "info",
    "timestamp": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_fakeip": true,
      "store_dns": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "access_control_allow_origin": [
        "http://127.0.0.1",
        "https://yacd.metacubex.one",
        "https://metacubex.github.io",
        "https://metacubexd.pages.dev",
        "https://board.zash.run.place"
      ]
    }
  },
  "http_clients": [
    {
      "tag": "default"
    }
  ],
  "dns": {
    "servers": [
      {
        "tag": "google",
        "type": "https",
        "server": "8.8.8.8",
        "detour": "总模式"
      },
      {
        "tag": "ali",
        "type": "https",
        "server": "223.5.5.5"
      },
      {
        "tag": "local",
        "type": "local"
      },
      {
        "tag": "fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "clash_mode": "Direct",
        "server": "ali"
      },
      {
        "clash_mode": "Global",
        "server": "google"
      },
      {
        "rule_set": "geosite-private",
        "server": "local"
      },
      {
        "domain_suffix": [
          "msftconnecttest.com",
          "msftncsi.com",
          "pool.ntp.org",
          "xboxlive.com",
          "srv.nintendo.net",
          "stun.playstation.net"
        ],
        "domain_regex": [
          "^time\\..+\\.(com|gov)$",
          "^ntp\\..+\\.com$",
          "^stun\\..+"
        ],
        "server": "ali"
      },
      {
        "rule_set": "geosite-cn",
        "server": "ali"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "fakeip"
      }
    ]
  },
  "inbounds": [
    {
      "type": "tun",
      "address": [
        "172.18.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "strict_route": true
    },
    {
      "type": "mixed",
      "listen": "::",
      "listen_port": 7890
    }
  ],
  "outbounds": {{ toPrettyJson $allOutbounds }},
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "ali"
    },
    "default_http_client": "default",
    "final": "漏网之鱼",
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "直连"
      },
      {
        "rule_set": "geosite-private",
        "outbound": "直连"
      },
      {
        "clash_mode": "Direct",
        "outbound": "直连"
      },
      {
        "clash_mode": "Global",
        "outbound": "总模式"
      },
      {
        "rule_set": "geosite-googlefcm",
        "outbound": "GoogleFCM"
      },
      {
        "rule_set": "geosite-youtube",
        "outbound": "YouTube"
      },
      {
        "rule_set": [
          "geosite-google",
          "geoip-google"
        ],
        "outbound": "Google"
      },
      {
        "rule_set": "ads",
        "action": "reject"
      },
      {
        "rule_set": "geosite-douyin",
        "outbound": "抖音"
      },
      {
        "rule_set": "geosite-xiaohongshu",
        "outbound": "小红书"
      },
      {
        "rule_set": [
          "geosite-bilibili",
          "geoip-bilibili"
        ],
        "outbound": "BiliBili"
      },
      {
        "rule_set": [
          "geosite-steam@cn",
          "geosite-category-games@cn"
        ],
        "outbound": "直连"
      },
      {
        "rule_set": "geosite-steam",
        "outbound": "Steam"
      },
      {
        "rule_set": "geosite-category-games-!cn",
        "outbound": "游戏平台"
      },
      {
        "rule_set": "geosite-github",
        "outbound": "GitHub"
      },
      {
        "rule_set": "geosite-discord",
        "outbound": "Discord"
      },
      {
        "rule_set": "geosite-tiktok",
        "outbound": "TikTok"
      },
      {
        "rule_set": [
          "geosite-twitter",
          "geoip-twitter"
        ],
        "outbound": "Twitter(X)"
      },
      {
        "rule_set": [
          "geosite-netflix",
          "geoip-netflix"
        ],
        "outbound": "Netflix"
      },
      {
        "rule_set": "geosite-disney",
        "outbound": "Disney+"
      },
      {
        "rule_set": [
          "geosite-hbo",
          "geosite-primevideo"
        ],
        "outbound": "海外媒体"
      },
      {
        "rule_set": "geosite-bahamut",
        "outbound": "巴哈姆特"
      },
      {
        "rule_set": "geosite-spotify",
        "outbound": "Spotify"
      },
      {
        "rule_set": [
          "geosite-facebook",
          "geoip-facebook"
        ],
        "outbound": "Facebook"
      },
      {
        "rule_set": "geosite-category-ai-!cn",
        "outbound": "AI"
      },
      {
        "rule_set": "geosite-paypal",
        "outbound": "PayPal"
      },
      {
        "rule_set": "geosite-category-cryptocurrency",
        "outbound": "加密货币"
      },
      {
        "rule_set": "geosite-category-speedtest@cn",
        "outbound": "直连"
      },
      {
        "rule_set": "geosite-category-speedtest",
        "outbound": "Speedtest"
      },
      {
        "rule_set": [
          "geosite-apple@cn",
          "geosite-microsoft@cn"
        ],
        "outbound": "直连"
      },
      {
        "rule_set": [
          "geosite-apple",
          "geoip-apple"
        ],
        "outbound": "Apple"
      },
      {
        "rule_set": "geosite-microsoft",
        "outbound": "Microsoft"
      },
      {
        "rule_set": [
          "geosite-telegram",
          "geoip-telegram"
        ],
        "outbound": "Telegram"
      },
      {
        "rule_set": "geosite-geolocation-!cn",
        "outbound": "总模式"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geoip-cn"
        ],
        "outbound": "直连"
      }
    ],
    "rule_set": {{ toPrettyJson $ruleSets }}
  }
}
