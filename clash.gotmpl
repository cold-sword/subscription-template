{{- $GiB := 1073741824.0 -}}
{{- $used := printf "%.2f" (divf (add (.UserInfo.Download | default 0 | float64) (.UserInfo.Upload | default 0 | float64)) $GiB) -}}
{{- $traffic := (.UserInfo.Traffic | default 0 | float64) -}}
{{- $total := printf "%.2f" (divf $traffic $GiB) -}}

{{- $ExpiredAt := "" -}}
{{- $expStr := printf "%v" .UserInfo.ExpiredAt -}}
{{- if regexMatch `^[0-9]+$` $expStr -}}
  {{- $ts := $expStr | float64 -}}
  {{- $sec := ternary (divf $ts 1000.0) $ts (ge (len $expStr) 13) -}}
  {{- $ExpiredAt = (date "2006-01-02 15:04:05" (unixEpoch ($sec | int64))) -}}
{{- else -}}
  {{- $ExpiredAt = $expStr -}}
{{- end -}}

{{- $sortFields := list "Sort" "Port" "Name" -}}
{{- $sortConfig := dict "Sort" "asc" "Port" "asc" "Name" "asc" -}}
{{- $byKey := dict -}}
{{- range $p := .Proxies -}}
  {{- $keyParts := list -}}
  {{- range $field := $sortFields -}}
    {{- $order := index $sortConfig $field -}}
    {{- $val := default "" (printf "%v" (index $p $field)) -}}
    {{- if or (eq $field "Sort") (eq $field "Port") -}}
      {{- $val = printf "%08d" (int (default 0 (index $p $field))) -}}
    {{- end -}}
    {{- if eq $order "desc" -}}
      {{- $val = printf "~%s" $val -}}
    {{- end -}}
    {{- $keyParts = append $keyParts $val -}}
  {{- end -}}
  {{- $_ := set $byKey (join "|" $keyParts) $p -}}
{{- end -}}
{{- $sorted := list -}}
{{- range $k := sortAlpha (keys $byKey) -}}
  {{- $sorted = append $sorted (index $byKey $k) -}}
{{- end -}}

{{- $supportSet := dict "shadowsocks" true "vmess" true "vless" true "trojan" true "hysteria2" true "hysteria" true "tuic" true "anytls" true -}}
{{- $supportedProxies := list -}}
{{- range $proxy := $sorted -}}
  {{- if hasKey $supportSet $proxy.Type -}}
    {{- $supportedProxies = append $supportedProxies $proxy -}}
  {{- else if and (eq $proxy.Type "snell") (eq (int (default 0 $proxy.Version)) 5) -}}
    {{- $supportedProxies = append $supportedProxies $proxy -}}
  {{- end -}}
{{- end -}}

{{- $proxyNames := "" -}}
{{- range $proxy := $supportedProxies -}}
  {{- if eq $proxyNames "" -}}
    {{- $proxyNames = printf "%q" $proxy.Name -}}
  {{- else -}}
    {{- $proxyNames = printf "%s, %q" $proxyNames $proxy.Name -}}
  {{- end -}}
{{- end -}}


{{- /* 地区分组：按节点名匹配，无节点的地区不生成 */ -}}
{{- $iconBase := "https://cdn.jsdelivr.net/gh/GitMetaio/Surfing@main/app/icon/" -}}
{{- $regionDefs := list
  (dict "name" "ALL·日本地区" "icon" "JP.svg" "re" `(?i)(日本|川日|东京|大阪|泉日|埼玉|沪日|深日|[^-]日|jp|japan)`)
  (dict "name" "ALL·中国台湾" "icon" "CN.svg" "re" `(?i)(台|新北|彰化|tw|taiwan|taipei)`)
  (dict "name" "ALL·香港地区" "icon" "HK.svg" "re" `(?i)(港|hk|hong ?kong)`)
  (dict "name" "ALL·美国地区" "icon" "US.svg" "re" `(?i)(美|波特兰|达拉斯|俄勒冈|凤凰城|费利蒙|硅谷|拉斯维加斯|洛杉矶|圣何塞|圣克拉拉|西雅图|芝加哥|us|united ?states)`)
  (dict "name" "ALL·狮城地区" "icon" "Singapore.svg" "re" `(?i)(新加坡|坡|狮城|sg|singapore)`)
-}}
{{- $matched := dict -}}
{{- $regionGroups := list -}}
{{- range $r := $regionDefs -}}
  {{- $members := list -}}
  {{- range $proxy := $supportedProxies -}}
    {{- if regexMatch $r.re $proxy.Name -}}
      {{- $members = append $members $proxy.Name -}}
      {{- $_ := set $matched $proxy.Name true -}}
    {{- end -}}
  {{- end -}}
  {{- if $members -}}
    {{- $regionGroups = append $regionGroups (dict "name" $r.name "icon" $r.icon "proxies" $members) -}}
  {{- end -}}
{{- end -}}
{{- $others := list -}}
{{- range $proxy := $supportedProxies -}}
  {{- if not (hasKey $matched $proxy.Name) -}}
    {{- $others = append $others $proxy.Name -}}
  {{- end -}}
{{- end -}}
{{- if $others -}}
  {{- $regionGroups = append $regionGroups (dict "name" "ALL·其它地区" "icon" "Globe.svg" "proxies" $others) -}}
{{- end -}}

{{- $allNames := list -}}
{{- range $proxy := $supportedProxies -}}
  {{- $allNames = append $allNames $proxy.Name -}}
{{- end -}}

{{- /* 策略组通用候选：总模式 → 自动组 → 地区组 → 拒绝/直连 → 全部节点 */ -}}
{{- $selectList := list "总模式" "ALL·延迟最低" "ALL·负载均衡" "ALL·故障转移" -}}
{{- range $g := $regionGroups -}}
  {{- $selectList = append $selectList $g.name -}}
{{- end -}}
{{- $selectList = concat $selectList (list "⛔️ 禁止·拒绝连接" "🌐 本机·本地直连") $allNames -}}
{{- /* 国内应用默认直连 */ -}}
{{- $directFirst := concat (list "🌐 本机·本地直连") (without $selectList "🌐 本机·本地直连") -}}

{{- $serviceGroups := list
  (dict "name" "小红书" "icon" "XiaoHongShu.svg" "direct" true)
  (dict "name" "抖音" "icon" "DouYin.svg" "direct" true)
  (dict "name" "BiliBili" "icon" "BiliBili.svg" "direct" true)
  (dict "name" "Steam" "icon" "Steam.svg")
  (dict "name" "Apple" "icon" "Apple.svg")
  (dict "name" "Microsoft" "icon" "Microsoft.svg")
  (dict "name" "Telegram" "icon" "Telegram.svg")
  (dict "name" "Discord" "icon" "Discord.svg")
  (dict "name" "Spotify" "icon" "Spotify.svg")
  (dict "name" "TikTok" "icon" "TikTok.svg")
  (dict "name" "YouTube" "icon" "YouTube.svg")
  (dict "name" "Netflix" "icon" "Netflix.svg")
  (dict "name" "Google" "icon" "Google.svg")
  (dict "name" "GoogleFCM" "icon" "GoogleFCM.svg")
  (dict "name" "Facebook" "icon" "Facebook.svg")
  (dict "name" "AI" "icon" "OpenAI.svg")
  (dict "name" "GitHub" "icon" "GitHub.svg")
  (dict "name" "Twitter(X)" "icon" "Twitter.svg")
  (dict "name" "DNS连接" "icon" "DNS.svg")
  (dict "name" "漏网之鱼" "icon" "HBASE-copy.svg")
-}}

# {{ .SiteName }}-{{ .SubscribeName }}
# Traffic: {{ $used }} GiB/{{ $total }} GiB | Expires: {{ $ExpiredAt }}
# Generated at: {{ now | date "2006-01-02 15:04:05" }}

# 基础设置
mixed-port: 10808
ipv6: true
mode: rule
allow-lan: true
bind-address: '*'
unified-delay: true
tcp-concurrent: true
log-level: info
external-controller: '0.0.0.0:9090'

# 节点记忆
profile:
  store-selected: true
  store-fake-ip: true

# 嗅探模块
sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: true
  override-destination: true
  sniff:
    HTTP:
      ports: [80, 8080-8880]
    TLS:
      ports: [443, 5228, 8443]
    QUIC:
      ports: [443, 8443]
  force-domain:
    - '+.v2ex.com'
  skip-domain:
    - '+.io.mi.com'

# 网卡模块
tun:
  enable: true
  stack: system
  auto-route: true
  auto-detect-interface: true
  dns-hijack:
    - any:53
    - tcp://any:53
  udp-timeout: 300

hosts:
  services.googleapis.cn: services.googleapis.com

# DNS模块
dns:
  enable: true
  cache-algorithm: arc
  listen: '0.0.0.0:1053'
  ipv6: true
  use-hosts: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-range6: fdfe:dcba:9876::/64
  fake-ip-filter:
    - 'RULE-SET:CN_域'
    - 'RULE-SET:Private_域'
    - 'RULE-SET:GoogleFCM_域'
  proxy-server-nameserver:
    - 'https://1.12.12.12:443/dns-query#🌐 本机·本地直连&h3=false'
    - 'https://120.53.53.53:443/dns-query#🌐 本机·本地直连&h3=false'
    - 'https://223.5.5.5:443/dns-query#🌐 本机·本地直连&h3=true'
    - 'https://223.6.6.6:443/dns-query#🌐 本机·本地直连&h3=true'
  nameserver-policy:
    'RULE-SET:CN_域,Microsoft_域,Apple_域':
      - 'https://1.12.12.12:443/dns-query#🌐 本机·本地直连&h3=false'
      - 'https://120.53.53.53:443/dns-query#🌐 本机·本地直连&h3=false'
      - 'https://223.5.5.5:443/dns-query#🌐 本机·本地直连&h3=true'
      - 'https://223.6.6.6:443/dns-query#🌐 本机·本地直连&h3=true'
  nameserver:
    - 'https://8.8.8.8:443/dns-query#DNS连接&h3=true'
    - 'https://8.8.4.4:443/dns-query#DNS连接&h3=true'
    - 'https://1.1.1.1:443/dns-query#DNS连接&h3=false'
    - 'https://1.0.0.1:443/dns-query#DNS连接&h3=false'
  direct-nameserver:
    - 1.12.12.12
    - 223.6.6.6

proxies:
- { name: 🌐 本机·本地直连, type: direct, udp: true }
- { name: ⛔️ 禁止·拒绝连接, type: reject }
- { name: 🌐 DNS_Hijack, type: dns }
{{- range $proxy := $supportedProxies }}
  {{- $server := $proxy.Server -}}
  {{- if and (contains $server ":") (not (hasPrefix "[" $server)) -}}
    {{- $server = printf "[%s]" $server -}}
  {{- end -}}

  {{- $password := $.UserInfo.Password -}}
  {{- if and (eq $proxy.Type "shadowsocks") (ne (default "" $proxy.ServerKey) "") -}}
    {{- $method := $proxy.Method -}}
    {{- if or (hasPrefix "2022-blake3-" $method) (eq $method "2022-blake3-aes-128-gcm") (eq $method "2022-blake3-aes-256-gcm") -}}
      {{- $userKeyLen := ternary 16 32 (hasSuffix "128-gcm" $method) -}}
      {{- $pwdStr := printf "%s" $password -}}
      {{- $userKey := ternary $pwdStr (trunc $userKeyLen $pwdStr) (le (len $pwdStr) $userKeyLen) -}}
      {{- $serverB64 := b64enc $proxy.ServerKey -}}
      {{- $userB64 := b64enc $userKey -}}
      {{- $password = printf "%s:%s" $serverB64 $userB64 -}}
    {{- end -}}
  {{- end -}}

  {{- $SkipVerify := $proxy.AllowInsecure -}}

{{- if eq $proxy.Type "shadowsocks" }}
- name: {{ $proxy.Name | quote }}
  type: ss
  server: {{ $server }}
  port: {{ $proxy.Port }}
  cipher: {{ default "aes-128-gcm" $proxy.Method }}
  password: {{ $password }}
  udp: true
  tfo: true
  {{- $obfsMode := default "" $proxy.Obfs -}}
  {{- if and (ne $obfsMode "") (ne $obfsMode "none") }}
  plugin: obfs
  plugin-opts:
    mode: {{ $obfsMode }}
    {{- if ne (default "" $proxy.ObfsHost) "" }}
    host: {{ $proxy.ObfsHost }}
    {{- end }}
  {{- end }}
{{- else if eq $proxy.Type "vmess" }}
- name: {{ $proxy.Name | quote }}
  type: vmess
  server: {{ $server }}
  port: {{ $proxy.Port }}
  uuid: {{ $password }}
  alterId: 0
  cipher: auto
  udp: true
  tfo: true
  {{- if or (eq $proxy.Transport "websocket") (eq $proxy.Transport "ws") }}
  network: ws
  ws-opts:
    path: {{ default "/" $proxy.Path }}
    {{- if ne (default "" $proxy.Host) "" }}
    headers:
      Host: {{ $proxy.Host }}
    {{- end }}
  {{- else if eq $proxy.Transport "http" }}
  network: http
  http-opts:
    method: GET
    path: [{{ default "/" $proxy.Path | quote }}]
    {{- if ne (default "" $proxy.Host) "" }}
    headers:
      Host: [{{ $proxy.Host | quote }}]
    {{- end }}
  {{- else if eq $proxy.Transport "grpc" }}
  network: grpc
  grpc-opts:
    grpc-service-name: {{ default "grpc" $proxy.ServiceName }}
  {{- end }}
  {{- if or (eq $proxy.Security "tls") (eq $proxy.Security "reality") }}
  tls: true
  {{- end }}
  {{- if ne (default "" $proxy.SNI) "" }}
  servername: {{ $proxy.SNI }}
  {{- end }}
  {{- if $SkipVerify }}
  skip-cert-verify: true
  {{- end }}
  {{- if ne (default "" $proxy.CertPinSHA256) "" }}
  fingerprint: {{ $proxy.CertPinSHA256 }}
  {{- end }}
  {{- if ne (default "" $proxy.Fingerprint) "" }}
  client-fingerprint: {{ $proxy.Fingerprint }}
  {{- end }}
  {{- if $proxy.EchEnable }}
  ech-opts:
    enable: true
    {{- if ne (default "" $proxy.EchServerName) "" }}
    query-server-name: {{ $proxy.EchServerName }}
    {{- end }}
  {{- end }}
{{- else if eq $proxy.Type "vless" }}
  {{- $encryptionStr := "" -}}
  {{- $encryption := default "none" $proxy.Encryption -}}
  {{- if eq $encryption "none" -}}
    {{- $encryptionStr = "none" -}}
  {{- else -}}
    {{- $encParts := list -}}
    {{- $encParts = append $encParts $encryption -}}
    {{- if ne (default "" $proxy.Encryption_Mode) "" -}}
      {{- $encParts = append $encParts $proxy.Encryption_Mode -}}
    {{- end -}}
    {{- if ne (default "" $proxy.EncryptionRtt) "" -}}
      {{- $encParts = append $encParts $proxy.EncryptionRtt -}}
    {{- end -}}
    {{- if ne (default "" $proxy.EncryptionClientPadding) "" -}}
      {{- $encParts = append $encParts $proxy.EncryptionClientPadding -}}
    {{- end -}}
    {{- if ne (default "" $proxy.EncryptionPassword) "" -}}
      {{- $encParts = append $encParts $proxy.EncryptionPassword -}}
    {{- end -}}
    {{- $encryptionStr = join "." $encParts -}}
  {{- end }}
- name: {{ $proxy.Name | quote }}
  type: vless
  server: {{ $server }}
  port: {{ $proxy.Port }}
  uuid: {{ $password }}
  udp: true
  tfo: true
  encryption: {{ $encryptionStr }}
  {{- if ne (default "" $proxy.Flow) "" }}
  flow: {{ $proxy.Flow }}
  {{- end }}
  {{- if or (eq $proxy.Transport "ws") (eq $proxy.Transport "websocket") }}
  network: ws
  ws-opts:
    path: {{ default "/" $proxy.Path }}
    {{- if ne (default "" $proxy.Host) "" }}
    headers:
      Host: {{ $proxy.Host }}
    {{- end }}
  {{- else if eq $proxy.Transport "http" }}
  network: http
  http-opts:
    method: GET
    path: [{{ default "/" $proxy.Path | quote }}]
    {{- if ne (default "" $proxy.Host) "" }}
    headers:
      Host: [{{ $proxy.Host | quote }}]
    {{- end }}
  {{- else if eq $proxy.Transport "httpupgrade" }}
  network: httpupgrade
  httpupgrade-opts:
    path: {{ default "/" $proxy.Path }}
    {{- if ne (default "" $proxy.Host) "" }}
    headers:
      Host: {{ $proxy.Host }}
    {{- end }}
  {{- else if eq $proxy.Transport "xhttp" }}
  network: xhttp
  xhttp-opts:
    path: {{ default "/" $proxy.Path }}
    {{- if ne (default "" $proxy.Host) "" }}
    host: {{ $proxy.Host }}
    {{- end }}
    {{- if ne (default "" $proxy.XhttpMode) "" }}
    mode: {{ $proxy.XhttpMode }}
    {{- end }}
    {{- if ne (default "" $proxy.XhttpExtra) "" }}
    {{- $extra := fromJson $proxy.XhttpExtra }}
    {{- if $extra.downloadSettings }}
    {{- $ds := $extra.downloadSettings }}
    download-settings:
      server: {{ $ds.address | quote }}
      port: {{ $ds.port }}
      network: {{ default "xhttp" $ds.network }}
      tls: true
      {{- if $ds.tlsSettings }}
      servername: {{ $ds.tlsSettings.serverName | quote }}
      alpn: {{ $ds.tlsSettings.alpn | toJson }}
      client-fingerprint: {{ default "chrome" $ds.tlsSettings.fingerprint }}
      {{- end }}
      {{- if $ds.realitySettings }}
      servername: {{ default "" $ds.realitySettings.serverName | quote }}
      client-fingerprint: {{ default "chrome" $ds.realitySettings.fingerprint }}
      reality-opts:
        public-key: {{ $ds.realitySettings.publicKey | quote }}
        short-id: {{ default "" $ds.realitySettings.shortId | quote }}
      {{- end }}
      {{- if $ds.xhttpSettings }}
      xhttp-opts:
        host: {{ $ds.xhttpSettings.host | quote }}
        path: {{ $ds.xhttpSettings.path | quote }}
        mode: {{ default "auto" $ds.xhttpSettings.mode }}
      {{- end }}
    {{- end }}
    {{- end }}
  {{- else if eq $proxy.Transport "grpc" }}
  network: grpc
  grpc-opts:
    grpc-service-name: {{ default "grpc" $proxy.ServiceName }}
  {{- end }}
  {{- if or (eq $proxy.Security "tls") (eq $proxy.Security "reality") }}
  tls: true
  {{- end }}
  {{- if ne (default "" $proxy.SNI) "" }}
  servername: {{ $proxy.SNI }}
  {{- end }}
  {{- if $proxy.AllowInsecure }}
  skip-cert-verify: true
  {{- end }}
  {{- if ne (default "" $proxy.CertPinSHA256) "" }}
  fingerprint: {{ $proxy.CertPinSHA256 }}
  {{- end }}
  {{- if ne (default "" $proxy.Fingerprint) "" }}
  client-fingerprint: {{ $proxy.Fingerprint }}
  {{- end }}
  {{- if and (eq $proxy.Security "reality") (ne (default "" $proxy.RealityPublicKey) "") }}
  reality-opts:
    public-key: {{ $proxy.RealityPublicKey }}
    {{- if ne (default "" $proxy.RealityShortId) "" }}
    short-id: {{ $proxy.RealityShortId }}
    {{- end }}
  {{- end }}
  {{- if $proxy.EchEnable }}
  ech-opts:
    enable: true
    {{- if ne (default "" $proxy.EchServerName) "" }}
    query-server-name: {{ $proxy.EchServerName }}
    {{- end }}
  {{- end }}
{{- else if eq $proxy.Type "trojan" }}
- name: {{ $proxy.Name | quote }}
  type: trojan
  server: {{ $server }}
  port: {{ $proxy.Port }}
  password: {{ $password }}
  udp: true
  tfo: true
  {{- if or (eq $proxy.Security "tls") (eq $proxy.Security "reality") }}
  tls: true
  {{- end }}
  {{- if ne (default "" $proxy.SNI) "" }}
  sni: {{ $proxy.SNI }}
  {{- end }}
  {{- if $SkipVerify }}
  skip-cert-verify: true
  {{- end }}
  {{- if ne (default "" $proxy.CertPinSHA256) "" }}
  fingerprint: {{ $proxy.CertPinSHA256 }}
  {{- end }}
  {{- if ne (default "" $proxy.Fingerprint) "" }}
  client-fingerprint: {{ $proxy.Fingerprint }}
  {{- end }}
  {{- if and (eq $proxy.Security "reality") (ne (default "" $proxy.RealityPublicKey) "") }}
  reality-opts:
    public-key: {{ $proxy.RealityPublicKey }}
    {{- if ne (default "" $proxy.RealityShortId) "" }}
    short-id: {{ $proxy.RealityShortId }}
    {{- end }}
  {{- end }}
  {{- if or (eq $proxy.Transport "ws") (eq $proxy.Transport "websocket") }}
  network: ws
  ws-opts:
    path: {{ default "/" $proxy.Path }}
    {{- if ne (default "" $proxy.Host) "" }}
    headers:
      Host: {{ $proxy.Host }}
    {{- end }}
  {{- else if eq $proxy.Transport "http" }}
  network: http
  http-opts:
    method: GET
    path: [{{ default "/" $proxy.Path | quote }}]
    {{- if ne (default "" $proxy.Host) "" }}
    headers:
      Host: [{{ $proxy.Host | quote }}]
    {{- end }}
  {{- else if eq $proxy.Transport "grpc" }}
  network: grpc
  grpc-opts:
    grpc-service-name: {{ default "grpc" $proxy.ServiceName }}
  {{- end }}
  {{- if $proxy.EchEnable }}
  ech-opts:
    enable: true
    {{- if ne (default "" $proxy.EchServerName) "" }}
    query-server-name: {{ $proxy.EchServerName }}
    {{- end }}
  {{- end }}
{{- else if or (eq $proxy.Type "hysteria2") (eq $proxy.Type "hysteria") }}
- name: {{ $proxy.Name | quote }}
  type: hysteria2
  server: {{ $server }}
  port: {{ $proxy.Port }}
  password: {{ $password }}
  udp: true
  tfo: true
  {{- if ne (default "" $proxy.SNI) "" }}
  sni: {{ $proxy.SNI }}
  {{- end }}
  {{- if $proxy.AllowInsecure }}
  skip-cert-verify: true
  {{- end }}
  {{- if ne (default "" $proxy.CertPinSHA256) "" }}
  fingerprint: {{ $proxy.CertPinSHA256 }}
  {{- end }}
  {{- if ne (default "" $proxy.ObfsPassword) "" }}
  obfs: salamander
  obfs-password: {{ $proxy.ObfsPassword }}
  {{- end }}
  {{- if ne (default "" $proxy.HopPorts) "" }}
  ports: {{ $proxy.HopPorts }}
  {{- end }}
  {{- if ne (default 0 $proxy.HopInterval) 0 }}
  hop-interval: {{ $proxy.HopInterval }}
  {{- end }}
  {{- if ne (default "" (printf "%v" $proxy.UpMbps)) "" }}
  up: "{{ $proxy.UpMbps }} Mbps"
  {{- end }}
  {{- if ne (default "" (printf "%v" $proxy.DownMbps)) "" }}
  down: "{{ $proxy.DownMbps }} Mbps"
  {{- end }}
  {{- if $proxy.EchEnable }}
  ech-opts:
    enable: true
    {{- if ne (default "" $proxy.EchServerName) "" }}
    query-server-name: {{ $proxy.EchServerName }}
    {{- end }}
  {{- end }}
{{- else if eq $proxy.Type "tuic" }}
- name: {{ $proxy.Name | quote }}
  type: tuic
  server: {{ $server }}
  port: {{ $proxy.Port }}
  uuid: {{ default "" $proxy.ServerKey }}
  password: {{ $password }}
  udp: true
  tfo: true
  {{- if ne (default "" $proxy.SNI) "" }}
  sni: {{ $proxy.SNI }}
  {{- end }}
  {{- if $proxy.AllowInsecure }}
  skip-cert-verify: true
  {{- end }}
  {{- if ne (default "" $proxy.CertPinSHA256) "" }}
  fingerprint: {{ $proxy.CertPinSHA256 }}
  {{- end }}
  {{- if $proxy.DisableSNI }}
  disable-sni: true
  {{- end }}
  {{- if $proxy.ReduceRtt }}
  reduce-rtt: true
  {{- end }}
  {{- if ne (default "" $proxy.UDPRelayMode) "" }}
  udp-relay-mode: {{ $proxy.UDPRelayMode }}
  {{- end }}
  {{- if ne (default "" $proxy.CongestionController) "" }}
  congestion-controller: {{ $proxy.CongestionController }}
  {{- end }}
  {{- if $proxy.EchEnable }}
  ech-opts:
    enable: true
    {{- if ne (default "" $proxy.EchServerName) "" }}
    query-server-name: {{ $proxy.EchServerName }}
    {{- end }}
  {{- end }}
{{- else if eq $proxy.Type "wireguard" }}
- name: {{ $proxy.Name | quote }}
  type: wireguard
  server: {{ $server }}
  port: {{ $proxy.Port }}
  private-key: {{ default "" $proxy.ServerKey }}
  public-key: {{ default "" $proxy.RealityPublicKey }}
  udp: true
  tfo: true
  {{- if ne (default "" $proxy.Path) "" }}
  preshared-key: {{ $proxy.Path }}
  {{- end }}
  {{- if ne (default "" $proxy.RealityServerAddr) "" }}
  ip: {{ $proxy.RealityServerAddr }}
  {{- end }}
  {{- if ne (default 0 $proxy.RealityServerPort) 0 }}
  ipv6: {{ $proxy.RealityServerPort }}
  {{- end }}
{{- else if eq $proxy.Type "anytls" }}
- name: {{ $proxy.Name | quote }}
  type: anytls
  server: {{ $server }}
  port: {{ $proxy.Port }}
  password: {{ $password }}
  udp: true
  tfo: true
  {{- if ne (default "" $proxy.SNI) "" }}
  sni: {{ $proxy.SNI }}
  {{- end }}
  {{- if $proxy.AllowInsecure }}
  skip-cert-verify: true
  {{- end }}
  {{- if ne (default "" $proxy.CertPinSHA256) "" }}
  fingerprint: {{ $proxy.CertPinSHA256 }}
  {{- end }}
  {{- if ne (default "" $proxy.Fingerprint) "" }}
  client-fingerprint: {{ $proxy.Fingerprint }}
  {{- end }}
  {{- if $proxy.EchEnable }}
  ech-opts:
    enable: true
    {{- if ne (default "" $proxy.EchServerName) "" }}
    query-server-name: {{ $proxy.EchServerName }}
    {{- end }}
  {{- end }}
{{- else if eq $proxy.Type "snell" }}
- name: {{ $proxy.Name | quote }}
  type: snell
  server: {{ $server }}
  port: {{ $proxy.Port }}
  psk: {{ $password }}
  version: 5
  reuse: true
  udp: true
  tfo: true
  {{- $obfsMode := default "" $proxy.Obfs -}}
  {{- if and (ne $obfsMode "") (ne $obfsMode "none") }}
  obfs-opts:
    mode: {{ $obfsMode }}
    {{- if ne (default "" $proxy.ObfsHost) "" }}
    host: {{ $proxy.ObfsHost }}
    {{- end }}
  {{- end }}
{{- else }}
- name: {{ $proxy.Name | quote }}
  type: {{ $proxy.Type }}
  server: {{ $server }}
  port: {{ $proxy.Port }}
  udp: true
  tfo: true
{{- end }}
{{- end }}

proxy-groups:
  - name: 总模式
    icon: {{ $iconBase }}All.svg
    type: select
    proxies:
      - ALL·延迟最低
      - ALL·负载均衡
      - ALL·故障转移
      {{- range $g := $regionGroups }}
      - {{ $g.name }}
      {{- end }}
      - 🌐 本机·本地直连
{{- range $g := $serviceGroups }}
  - name: {{ $g.name }}
    icon: {{ $iconBase }}{{ $g.icon }}
    type: select
    proxies:
      {{- range $n := ternary $directFirst $selectList (hasKey $g "direct") }}
      - {{ $n | quote }}
      {{- end }}
{{- end }}
  - name: 广告拦截
    icon: {{ $iconBase }}No-ads-all.svg
    type: select
    proxies:
      - PASS
      - REJECT-DROP
      - ⛔️ 禁止·拒绝连接
      - 🌐 DNS_Hijack
  - name: WebRTC
    icon: {{ $iconBase }}WebRTC.svg
    type: select
    proxies:
      - ⛔️ 禁止·拒绝连接
      - 🌐 DNS_Hijack
      - REJECT-DROP
      - PASS
  - name: ALL·延迟最低
    icon: {{ $iconBase }}Return.svg
    type: url-test
    url: https://www.gstatic.com/generate_204
    interval: 300
    proxies:
      {{- range $n := $allNames }}
      - {{ $n | quote }}
      {{- end }}
  - name: ALL·负载均衡
    icon: {{ $iconBase }}Return.svg
    type: load-balance
    strategy: round-robin
    url: https://www.gstatic.com/generate_204
    interval: 300
    proxies:
      {{- range $n := $allNames }}
      - {{ $n | quote }}
      {{- end }}
  - name: ALL·故障转移
    icon: {{ $iconBase }}Return.svg
    type: fallback
    url: https://www.gstatic.com/generate_204
    interval: 300
    proxies:
      {{- range $n := $allNames }}
      - {{ $n | quote }}
      {{- end }}
{{- range $g := $regionGroups }}
  - name: {{ $g.name }}
    icon: {{ $iconBase }}{{ $g.icon }}
    type: url-test
    url: https://www.gstatic.com/generate_204
    interval: 300
    proxies:
      {{- range $n := $g.proxies }}
      - {{ $n | quote }}
      {{- end }}
{{- end }}

# 规则来源: https://github.com/MetaCubeX/meta-rules-dat
rule-providers:
{{- $ruleBase := "https://cdn.jsdmirror.com/gh/MetaCubeX/meta-rules-dat@meta" -}}
{{- $mrs := list
  (list "CN_IP" "ipcidr" "geo-lite/geoip/cn")
  (list "CN_域" "domain" "geo/geosite/cn")
  (list "XiaoHongShu_域" "domain" "geo/geosite/xiaohongshu")
  (list "DouYin_域" "domain" "geo/geosite/douyin")
  (list "BiliBili_域" "domain" "geo/geosite/bilibili")
  (list "BiliBili_IP" "ipcidr" "geo-lite/geoip/bilibili")
  (list "Steam_域" "domain" "geo/geosite/steam")
  (list "TikTok_域" "domain" "geo/geosite/tiktok")
  (list "Spotify_域" "domain" "geo/geosite/spotify")
  (list "Facebook_域" "domain" "geo/geosite/facebook")
  (list "Facebook_IP" "ipcidr" "geo-lite/geoip/facebook")
  (list "Telegram_域" "domain" "geo/geosite/telegram")
  (list "Telegram_IP" "ipcidr" "geo-lite/geoip/telegram")
  (list "YouTube_域" "domain" "geo/geosite/youtube")
  (list "Google_域" "domain" "geo/geosite/google")
  (list "Google_IP" "ipcidr" "geo-lite/geoip/google")
  (list "GoogleFCM_域" "domain" "geo/geosite/googlefcm")
  (list "Microsoft_域" "domain" "geo/geosite/microsoft")
  (list "Apple_域" "domain" "geo/geosite/apple")
  (list "Apple_IP" "ipcidr" "geo-lite/geoip/apple")
  (list "AI_域" "domain" "geo/geosite/category-ai-!cn")
  (list "Netflix_域" "domain" "geo/geosite/netflix")
  (list "Netflix_IP" "ipcidr" "geo-lite/geoip/netflix")
  (list "Discord_域" "domain" "geo/geosite/discord")
  (list "GitHub_域" "domain" "geo/geosite/github")
  (list "Twitter_域" "domain" "geo/geosite/twitter")
  (list "Twitter_IP" "ipcidr" "geo-lite/geoip/twitter")
  (list "Private_域" "domain" "geo/geosite/private")
  (list "Private_IP" "ipcidr" "geo-lite/geoip/private")
}}
  WebRTC_端/域:
    type: http
    behavior: classical
    format: text
    url: https://cdn.jsdmirror.com/gh/GitMetaio/Surfing@main/box_bll/clash/rules/WebRTC.list
    interval: 86400
  No-ads-all_域:
    type: http
    behavior: domain
    format: mrs
    url: https://cdn.jsdmirror.com/gh/TG-Twilight/AWAvenue-Ads-Rule@main/Filters/AWAvenue-Ads-Rule-Clash.mrs
    interval: 86400
{{- range $r := $mrs }}
  {{ index $r 0 }}:
    type: http
    behavior: {{ index $r 1 }}
    format: mrs
    url: {{ $ruleBase }}/{{ index $r 2 }}.mrs
    interval: 86400
{{- end }}

rules:
  - DST-PORT,53,🌐 DNS_Hijack
  - DST-PORT,853,DNS连接
  - RULE-SET,WebRTC_端/域,WebRTC
