{{- $GiB := 1073741824.0 -}}
{{- $used := printf "%.2f" (divf (add (.UserInfo.Download | default 0 | float64) (.UserInfo.Upload | default 0 | float64)) $GiB) -}}
{{- $traffic := (.UserInfo.Traffic | default 0 | float64) -}}
{{- $total := printf "%.2f" (divf $traffic $GiB) -}}

{{- $ExpiredAt := "" -}}
{{- $expStr := printf "%v" .UserInfo.ExpiredAt -}}
{{- if regexMatch `^[0-9]+$` $expStr -}}
  {{- $ts := $expStr | float64 -}}
  {{- $sec := ternary (divf $ts 1000.0) $ts (ge (len $expStr) 13) -}}
  {{- $ExpiredAt = (date "2006-01-02 15:04:05" (unixEpoch ($sec | int64))) -}}
{{- else -}}
  {{- $ExpiredAt = $expStr -}}
{{- end -}}

{{- $sortFields := list "Sort" "Port" "Name" -}}
{{- $sortConfig := dict "Sort" "asc" "Port" "asc" "Name" "asc" -}}
{{- $byKey := dict -}}
{{- range $p := .Proxies -}}
  {{- $keyParts := list -}}
  {{- range $field := $sortFields -}}
    {{- $order := index $sortConfig $field -}}
    {{- $val := default "" (printf "%v" (index $p $field)) -}}
    {{- if or (eq $field "Sort") (eq $field "Port") -}}
      {{- $val = printf "%08d" (int (default 0 (index $p $field))) -}}
    {{- end -}}
    {{- if eq $order "desc" -}}
      {{- $val = printf "~%s" $val -}}
    {{- end -}}
    {{- $keyParts = append $keyParts $val -}}
  {{- end -}}
  {{- $_ := set $byKey (join "|" $keyParts) $p -}}
{{- end -}}
{{- $sorted := list -}}
{{- range $k := sortAlpha (keys $byKey) -}}
  {{- $sorted = append $sorted (index $byKey $k) -}}
{{- end -}}

{{- $supportSet := dict "shadowsocks" true "vmess" true "vless" true "trojan" true "hysteria2" true "hysteria" true "tuic" true "wireguard" true "anytls" true -}}
{{- $supportedProxies := list -}}
{{- range $proxy := $sorted -}}
  {{- if hasKey $supportSet $proxy.Type -}}
    {{- $supportedProxies = append $supportedProxies $proxy -}}
  {{- end -}}
{{- end -}}

{{- $proxyNames := "" -}}
{{- range $proxy := $supportedProxies -}}
  {{- if eq $proxyNames "" -}}
    {{- $proxyNames = $proxy.Name -}}
  {{- else -}}
    {{- $proxyNames = printf "%s, %s" $proxyNames $proxy.Name -}}
  {{- end -}}
{{- end -}}


{{- /* 地区分组：按节点名匹配，无节点的地区不生成 */ -}}
{{- /* 图标：Koolson/Qure 彩色图标为主，缺失的用 GitMetaio/Surfing 补 */ -}}
{{- $q := "https://cdn.jsdmirror.com/gh/Koolson/Qure@master/IconSet/Color/" -}}
{{- $s := "https://cdn.jsdmirror.com/gh/GitMetaio/Surfing@main/app/icon/" -}}
{{- $regionDefs := list
  (dict "name" "ALL·日本地区" "icon" (print $q "Japan.png") "re" `(?i)(日本|川日|东京|大阪|泉日|埼玉|沪日|深日|[^-]日|jp|japan)`)
  (dict "name" "ALL·中国台湾" "icon" (print $q "Taiwan.png") "re" `(?i)(台|新北|彰化|tw|taiwan|taipei)`)
  (dict "name" "ALL·香港地区" "icon" (print $q "Hong_Kong.png") "re" `(?i)(港|hk|hong ?kong)`)
  (dict "name" "ALL·美国地区" "icon" (print $q "United_States.png") "re" `(?i)(美|波特兰|达拉斯|俄勒冈|凤凰城|费利蒙|硅谷|拉斯维加斯|洛杉矶|圣何塞|圣克拉拉|西雅图|芝加哥|us|united ?states)`)
  (dict "name" "ALL·狮城地区" "icon" (print $q "Singapore.png") "re" `(?i)(新加坡|坡|狮城|sg|singapore)`)
-}}
{{- $matched := dict -}}
{{- $regionGroups := list -}}
{{- range $r := $regionDefs -}}
  {{- $members := list -}}
  {{- range $proxy := $supportedProxies -}}
    {{- if regexMatch $r.re $proxy.Name -}}
      {{- $members = append $members $proxy.Name -}}
      {{- $_ := set $matched $proxy.Name true -}}
    {{- end -}}
  {{- end -}}
  {{- if $members -}}
    {{- $regionGroups = append $regionGroups (dict "name" $r.name "icon" $r.icon "proxies" $members) -}}
  {{- end -}}
{{- end -}}
{{- $others := list -}}
{{- range $proxy := $supportedProxies -}}
  {{- if not (hasKey $matched $proxy.Name) -}}
    {{- $others = append $others $proxy.Name -}}
  {{- end -}}
{{- end -}}
{{- if $others -}}
  {{- $regionGroups = append $regionGroups (dict "name" "ALL·其它地区" "icon" (print $q "World_Map.png") "proxies" $others) -}}
{{- end -}}

{{- $allNames := list -}}
{{- range $proxy := $supportedProxies -}}
  {{- $allNames = append $allNames $proxy.Name -}}
{{- end -}}

{{- /* 策略组通用候选：总模式 → 自动组 → 地区组 → 拒绝/直连 → 全部节点 */ -}}
{{- $selectList := list "总模式" "ALL·延迟最低" "ALL·负载均衡" "ALL·故障转移" -}}
{{- range $g := $regionGroups -}}
  {{- $selectList = append $selectList $g.name -}}
{{- end -}}
{{- $selectList = concat $selectList (list "⛔️ 禁止·拒绝连接" "🌐 本机·本地直连") $allNames -}}
{{- /* 国内应用默认直连 */ -}}
{{- $serviceGroups := list
  (dict "name" "小红书" "icon" (print $s "XiaoHongShu.svg") "prefer" "🌐 本机·本地直连")
  (dict "name" "抖音" "icon" (print $s "DouYin.svg") "prefer" "🌐 本机·本地直连")
  (dict "name" "BiliBili" "icon" (print $q "bilibili.png") "prefer" "🌐 本机·本地直连")
  (dict "name" "Steam" "icon" (print $q "Steam.png"))
  (dict "name" "游戏平台" "icon" (print $q "Game.png"))
  (dict "name" "Apple" "icon" (print $q "Apple.png"))
  (dict "name" "Microsoft" "icon" (print $q "Microsoft.png"))
  (dict "name" "Telegram" "icon" (print $q "Telegram.png"))
  (dict "name" "Discord" "icon" (print $q "Discord.png"))
  (dict "name" "Spotify" "icon" (print $q "Spotify.png"))
  (dict "name" "TikTok" "icon" (print $q "TikTok.png"))
  (dict "name" "YouTube" "icon" (print $q "YouTube.png"))
  (dict "name" "Netflix" "icon" (print $q "Netflix.png"))
  (dict "name" "Disney+" "icon" (print $q "Disney+.png"))
  (dict "name" "海外媒体" "icon" (print $q "ForeignMedia.png"))
  (dict "name" "巴哈姆特" "icon" (print $q "Bahamut.png") "prefer" "ALL·中国台湾")
  (dict "name" "Google" "icon" (print $q "Google_Search.png"))
  (dict "name" "GoogleFCM" "icon" (print $s "GoogleFCM.svg"))
  (dict "name" "Facebook" "icon" (print $q "Facebook.png"))
  (dict "name" "AI" "icon" (print $q "AI.png"))
  (dict "name" "GitHub" "icon" (print $q "GitHub.png"))
  (dict "name" "Twitter(X)" "icon" (print $q "X.png"))
  (dict "name" "PayPal" "icon" (print $q "PayPal.png"))
  (dict "name" "加密货币" "icon" (print $q "Cryptocurrency.png") "prefer" "ALL·中国台湾")
  (dict "name" "Speedtest" "icon" (print $q "Speedtest.png"))
  (dict "name" "漏网之鱼" "icon" (print $q "Final.png"))
-}}

# {{ .SiteName }}-{{ .SubscribeName }}
# Traffic: {{ $used }} GiB/{{ $total }} GiB | Expires: {{ $ExpiredAt }}
# Generated at: {{ now | date "2006-01-02 15:04:05" }}

mode: rule
log-level: info
dns:
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  nameserver:
    - system
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
proxies:
{{- range $proxy := $supportedProxies }}
  {{- $common := "udp: true" -}}

  {{- $server := $proxy.Server -}}
  {{- if and (contains $server ":") (not (hasPrefix "[" $server)) -}}
    {{- $server = printf "[%s]" $server -}}
  {{- end -}}

  {{- $password := $.UserInfo.Password -}}
  {{- if and (eq $proxy.Type "shadowsocks") (ne (default "" $proxy.ServerKey) "") -}}
    {{- $method := $proxy.Method -}}
    {{- if or (hasPrefix "2022-blake3-" $method) (eq $method "2022-blake3-aes-128-gcm") (eq $method "2022-blake3-aes-256-gcm") -}}
      {{- $userKeyLen := ternary 16 32 (hasSuffix "128-gcm" $method) -}}
      {{- $pwdStr := printf "%s" $password -}}
      {{- $userKey := ternary $pwdStr (trunc $userKeyLen $pwdStr) (le (len $pwdStr) $userKeyLen) -}}
      {{- $serverB64 := b64enc $proxy.ServerKey -}}
      {{- $userB64 := b64enc $userKey -}}
      {{- $password = printf "%s:%s" $serverB64 $userB64 -}}
    {{- end -}}
  {{- end -}}

  {{- $SkipVerify := $proxy.AllowInsecure -}}

  {{- if eq $proxy.Type "shadowsocks" }}
  - { name: {{ $proxy.Name | quote }}, type: ss, server: {{ $server }}, port: {{ $proxy.Port }}, cipher: {{ default "aes-128-gcm" $proxy.Method }}, password: {{ $password }}, {{ $common }}{{- if ne (default "" $proxy.Obfs) "" }}, plugin: obfs, plugin-opts: { mode: {{ $proxy.Obfs }}, host: {{ default "" $proxy.ObfsHost }} }{{- end }} }
  {{- else if eq $proxy.Type "vmess" }}
  - { name: {{ $proxy.Name | quote }}, type: vmess, server: {{ $server }}, port: {{ $proxy.Port }}, uuid: {{ $password }}, alterId: 0, cipher: auto, {{ $common }}{{- if or (eq $proxy.Transport "websocket") (eq $proxy.Transport "ws") }}, network: ws, ws-opts: { path: {{ default "/" $proxy.Path }}{{- if ne (default "" $proxy.Host) "" }}, headers: { Host: {{ $proxy.Host }} }{{- end }} }{{- else if eq $proxy.Transport "http" }}, network: http, http-opts: { method: GET, path: [{{ default "/" $proxy.Path | quote }}]{{- if ne (default "" $proxy.Host) "" }}, headers: { Host: [{{ $proxy.Host | quote }}] }{{- end }} }{{- else if eq $proxy.Transport "xhttp" }}, network: xhttp, xhttp-opts: { path: {{ default "/" $proxy.Path }}{{- if ne (default "" $proxy.Host) "" }}, host: {{ $proxy.Host }}{{- end }}{{- if ne (default "" $proxy.XhttpMode) "" }}, mode: {{ $proxy.XhttpMode }}{{- end }} }{{- else if eq $proxy.Transport "grpc" }}, network: grpc, grpc-opts: { grpc-service-name: {{ default "grpc" $proxy.ServiceName }} }{{- end }}{{- if or (eq $proxy.Security "tls") (eq $proxy.Security "reality") }}, tls: true{{- end }}{{- if ne (default "" $proxy.SNI) "" }}, servername: {{ $proxy.SNI }}{{- end }}{{- if $SkipVerify }}, skip-cert-verify: true{{- end }}{{- if ne (default "" $proxy.CertPinSHA256) "" }}, fingerprint: {{ $proxy.CertPinSHA256 }}{{- end }}{{- if ne (default "" $proxy.Fingerprint) "" }}, client-fingerprint: {{ $proxy.Fingerprint }}{{- end }} }
  {{- else if eq $proxy.Type "vless" }}
  - { name: {{ $proxy.Name | quote }}, type: vless, server: {{ $server }}, port: {{ $proxy.Port }}, uuid: {{ $password }}, {{ $common }}{{- if or (eq $proxy.Transport "ws") (eq $proxy.Transport "websocket") }}, network: ws, ws-opts: { path: {{ default "/" $proxy.Path }}{{- if ne (default "" $proxy.Host) "" }}, headers: { Host: {{ $proxy.Host }} }{{- end }} }{{- else if eq $proxy.Transport "http" }}, network: http, http-opts: { method: GET, path: [{{ default "/" $proxy.Path | quote }}]{{- if ne (default "" $proxy.Host) "" }}, headers: { Host: [{{ $proxy.Host | quote }}] }{{- end }} }{{- else if eq $proxy.Transport "xhttp" }}, network: xhttp, xhttp-opts: { path: {{ default "/" $proxy.Path }}{{- if ne (default "" $proxy.Host) "" }}, host: {{ $proxy.Host }}{{- end }}{{- if ne (default "" $proxy.XhttpMode) "" }}, mode: {{ $proxy.XhttpMode }}{{- end }} }{{- else if eq $proxy.Transport "grpc" }}, network: grpc, grpc-opts: { grpc-service-name: {{ default "grpc" $proxy.ServiceName }} }{{- end }}{{- if ne (default "" $proxy.SNI) "" }}, servername: {{ $proxy.SNI }}{{- end }}{{- if $SkipVerify }}, skip-cert-verify: true{{- end }}{{- if ne (default "" $proxy.CertPinSHA256) "" }}, fingerprint: {{ $proxy.CertPinSHA256 }}{{- end }}{{- if ne (default "" $proxy.Fingerprint) "" }}, client-fingerprint: {{ $proxy.Fingerprint }}{{- end }}{{- if and (eq $proxy.Security "reality") (ne (default "" $proxy.RealityPublicKey) "") }}, reality-opts: { public-key: {{ $proxy.RealityPublicKey }}{{- if ne (default "" $proxy.RealityShortId) "" }}, short-id: {{ $proxy.RealityShortId }}{{- end }} }{{- end }}{{- if and (ne (default "" $proxy.Flow) "") (ne $proxy.Flow "none") }}, flow: {{ $proxy.Flow }}{{- end }} }
  {{- else if eq $proxy.Type "trojan" }}
  - { name: {{ $proxy.Name | quote }}, type: trojan, server: {{ $server }}, port: {{ $proxy.Port }}, password: {{ $password }}, {{ $common }}{{- if ne (default "" $proxy.SNI) "" }}, sni: {{ $proxy.SNI }}{{- end }}{{- if $SkipVerify }}, skip-cert-verify: true{{- end }}{{- if ne (default "" $proxy.CertPinSHA256) "" }}, fingerprint: {{ $proxy.CertPinSHA256 }}{{- end }}{{- if ne (default "" $proxy.Fingerprint) "" }}, client-fingerprint: {{ $proxy.Fingerprint }}{{- end }}{{- if or (eq $proxy.Transport "ws") (eq $proxy.Transport "websocket") }}, network: ws, ws-opts: { path: {{ default "/" $proxy.Path }}{{- if ne (default "" $proxy.Host) "" }}, headers: { Host: {{ $proxy.Host }} }{{- end }} }{{- else if eq $proxy.Transport "http" }}, network: http, http-opts: { method: GET, path: [{{ default "/" $proxy.Path | quote }}]{{- if ne (default "" $proxy.Host) "" }}, headers: { Host: [{{ $proxy.Host | quote }}] }{{- end }} }{{- else if eq $proxy.Transport "grpc" }}, network: grpc, grpc-opts: { grpc-service-name: {{ default "grpc" $proxy.ServiceName }} }{{- end }} }
  {{- else if or (eq $proxy.Type "hysteria2") (eq $proxy.Type "hysteria") }}
  - { name: {{ $proxy.Name | quote }}, type: hysteria2, server: {{ $server }}, port: {{ $proxy.Port }}, password: {{ $password }}, {{ $common }}{{- if ne (default "" $proxy.SNI) "" }}, sni: {{ $proxy.SNI }}{{- end }}{{- if $SkipVerify }}, skip-cert-verify: true{{- end }}{{- if ne (default "" $proxy.CertPinSHA256) "" }}, fingerprint: {{ $proxy.CertPinSHA256 }}{{- end }}{{- if ne (default "" $proxy.ObfsPassword) "" }}, obfs: salamander, obfs-password: {{ $proxy.ObfsPassword }}{{- end }}{{- if ne (default "" $proxy.HopPorts) "" }}, ports: {{ $proxy.HopPorts }}{{- end }}{{- if ne (default 0 $proxy.HopInterval) 0 }}, hop-interval: {{ $proxy.HopInterval }}{{- end }} }
  {{- else if eq $proxy.Type "tuic" }}
  - { name: {{ $proxy.Name | quote }}, type: tuic, server: {{ $server }}, port: {{ $proxy.Port }}, uuid: {{ default "" $proxy.ServerKey }}, password: {{ $password }}, {{ $common }}{{- if ne (default "" $proxy.SNI) "" }}, sni: {{ $proxy.SNI }}{{- end }}{{- if $SkipVerify }}, skip-cert-verify: true{{- end }}{{- if ne (default "" $proxy.CertPinSHA256) "" }}, fingerprint: {{ $proxy.CertPinSHA256 }}{{- end }}{{- if $proxy.DisableSNI }}, disable-sni: true{{- end }}{{- if $proxy.ReduceRtt }}, reduce-rtt: true{{- end }}{{- if ne (default "" $proxy.UDPRelayMode) "" }}, udp-relay-mode: {{ $proxy.UDPRelayMode }}{{- end }}{{- if ne (default "" $proxy.CongestionController) "" }}, congestion-controller: {{ $proxy.CongestionController }}{{- end }} }
  {{- else if eq $proxy.Type "wireguard" }}
  - { name: {{ $proxy.Name | quote }}, type: wireguard, server: {{ $server }}, port: {{ $proxy.Port }}, private-key: {{ default "" $proxy.ServerKey }}, public-key: {{ default "" $proxy.RealityPublicKey }}, {{ $common }}{{- if ne (default "" $proxy.Path) "" }}, preshared-key: {{ $proxy.Path }}{{- end }}{{- if ne (default "" $proxy.RealityServerAddr) "" }}, ip: {{ $proxy.RealityServerAddr }}{{- end }}{{- if ne (default 0 $proxy.RealityServerPort) 0 }}, ipv6: {{ $proxy.RealityServerPort }}{{- end }} }
  {{- else if eq $proxy.Type "anytls" }}
  - { name: {{ $proxy.Name | quote }}, type: anytls, server: {{ $server }}, port: {{ $proxy.Port }}, password: {{ $password }}, {{ $common }}{{- if ne (default "" $proxy.SNI) "" }}, sni: {{ $proxy.SNI }}{{- end }}{{- if $proxy.AllowInsecure }}, skip-cert-verify: true{{- end }}{{- if ne (default "" $proxy.CertPinSHA256) "" }}, fingerprint: {{ $proxy.CertPinSHA256 }}{{- end }}{{- if ne (default "" $proxy.Fingerprint) "" }}, client-fingerprint: {{ $proxy.Fingerprint }}{{- end }} }
  {{- else }}
  - { name: {{ $proxy.Name | quote }}, type: {{ $proxy.Type }}, server: {{ $server }}, port: {{ $proxy.Port }}, {{ $common }} }
  {{- end }}
{{- end }}

proxy-groups:
  - name: 总模式
    icon: {{ $q }}Proxy.png
    type: select
    proxies:
      - ALL·延迟最低
      - ALL·负载均衡
      - ALL·故障转移
      {{- range $g := $regionGroups }}
      - {{ $g.name }}
      {{- end }}
      - 🌐 本机·本地直连
{{- range $g := $serviceGroups }}
  - name: {{ $g.name }}
    icon: {{ $g.icon }}
    type: select
    proxies:
      {{- $opts := $selectList -}}
      {{- if and (hasKey $g "prefer") (has $g.prefer $selectList) -}}
        {{- $opts = concat (list $g.prefer) (without $selectList $g.prefer) -}}
      {{- end }}
      {{- range $n := $opts }}
      - {{ $n | quote }}
      {{- end }}
{{- end }}
  - name: 广告拦截
    icon: {{ $q }}Advertising.png
    type: select
    proxies:
      - ⛔️ 禁止·拒绝连接
      - 🌐 本机·本地直连
  - name: 🌐 本机·本地直连
    icon: {{ $q }}Direct.png
    type: select
    proxies:
      - DIRECT
  - name: ⛔️ 禁止·拒绝连接
    icon: {{ $q }}Reject.png
    type: select
    proxies:
      - REJECT
  - name: ALL·延迟最低
    icon: {{ $q }}Auto.png
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies:
      {{- range $n := $allNames }}
      - {{ $n | quote }}
      {{- end }}
  - name: ALL·负载均衡
    icon: {{ $q }}Round_Robin.png
    type: load-balance
    strategy: round-robin
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies:
      {{- range $n := $allNames }}
      - {{ $n | quote }}
      {{- end }}
  - name: ALL·故障转移
    icon: {{ $q }}Available.png
    type: fallback
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies:
      {{- range $n := $allNames }}
      - {{ $n | quote }}
      {{- end }}
{{- range $g := $regionGroups }}
  - name: {{ $g.name }}
    icon: {{ $g.icon }}
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies:
      {{- range $n := $g.proxies }}
      - {{ $n | quote }}
      {{- end }}
{{- end }}

rules:
  - RULE-SET,Lan,🌐 本机·本地直连
  - RULE-SET,GoogleFCM,GoogleFCM
  - RULE-SET,YouTube,YouTube
  - RULE-SET,Google,Google
  - RULE-SET,AdvertisingLite,广告拦截
  - RULE-SET,DouYin,抖音
  - RULE-SET,XiaoHongShu,小红书
  - RULE-SET,BiliBili,BiliBili
  # Steam 国内 CDN 下载直连，商店与登录仍走 Steam 组
  - RULE-SET,SteamCN,🌐 本机·本地直连
  - RULE-SET,Steam,Steam
  - RULE-SET,Game,游戏平台
  - RULE-SET,GitHub,GitHub
  - RULE-SET,Discord,Discord
  - RULE-SET,TikTok,TikTok
  - RULE-SET,Twitter,Twitter(X)
  - RULE-SET,Netflix,Netflix
  - RULE-SET,Disney,Disney+
  - RULE-SET,HBO,海外媒体
  - RULE-SET,PrimeVideo,海外媒体
  - RULE-SET,Bahamut,巴哈姆特
  - RULE-SET,Spotify,Spotify
  - RULE-SET,Facebook,Facebook
  - RULE-SET,OpenAI,AI
  - RULE-SET,Claude,AI
  - RULE-SET,Gemini,AI
  - RULE-SET,Copilot,AI
  - RULE-SET,PayPal,PayPal
  - RULE-SET,Cryptocurrency,加密货币
  - RULE-SET,Speedtest,Speedtest
  - RULE-SET,Apple,Apple
  - RULE-SET,Microsoft,Microsoft
  - RULE-SET,Telegram,Telegram
  - RULE-SET,Global,总模式
  - RULE-SET,ChinaMax,🌐 本机·本地直连
  - GEOIP,CN,🌐 本机·本地直连
  - MATCH,漏网之鱼

# 规则来源: blackmatrix7/ios_rule_script（perfect-panel/rules 镜像）
rule-providers:
{{- $rp := "https://cdn.jsdmirror.com/gh/perfect-panel/rules/rule/Clash" -}}
{{- $rules := list
  (list "Lan" "Lan/Lan_No_Resolve")
  (list "GoogleFCM" "GoogleFCM/GoogleFCM_No_Resolve")
  (list "YouTube" "YouTube/YouTube_No_Resolve")
  (list "Google" "Google/Google_No_Resolve")
  (list "AdvertisingLite" "AdvertisingLite/AdvertisingLite_Classical_No_Resolve")
  (list "DouYin" "DouYin/DouYin_No_Resolve")
  (list "XiaoHongShu" "XiaoHongShu/XiaoHongShu_No_Resolve")
  (list "BiliBili" "BiliBili/BiliBili_No_Resolve")
  (list "SteamCN" "SteamCN/SteamCN_No_Resolve")
  (list "Steam" "Steam/Steam_No_Resolve")
  (list "Game" "Game/Game_No_Resolve")
  (list "GitHub" "GitHub/GitHub_No_Resolve")
  (list "Discord" "Discord/Discord_No_Resolve")
  (list "TikTok" "TikTok/TikTok_No_Resolve")
  (list "Twitter" "Twitter/Twitter_No_Resolve")
  (list "Netflix" "Netflix/Netflix_Classical_No_Resolve")
  (list "Disney" "Disney/Disney_No_Resolve")
  (list "HBO" "HBO/HBO_No_Resolve")
  (list "PrimeVideo" "PrimeVideo/PrimeVideo_No_Resolve")
  (list "Bahamut" "Bahamut/Bahamut_No_Resolve")
  (list "Spotify" "Spotify/Spotify_No_Resolve")
  (list "Facebook" "Facebook/Facebook_No_Resolve")
  (list "OpenAI" "OpenAI/OpenAI_No_Resolve")
  (list "Claude" "Claude/Claude_No_Resolve")
  (list "Gemini" "Gemini/Gemini_No_Resolve")
  (list "Copilot" "Copilot/Copilot_No_Resolve")
  (list "PayPal" "PayPal/PayPal_No_Resolve")
  (list "Cryptocurrency" "Cryptocurrency/Cryptocurrency_No_Resolve")
  (list "Speedtest" "Speedtest/Speedtest_No_Resolve")
  (list "Apple" "Apple/Apple_Classical_No_Resolve")
  (list "Microsoft" "Microsoft/Microsoft_No_Resolve")
  (list "Telegram" "Telegram/Telegram_No_Resolve")
  (list "Global" "Global/Global_Classical_No_Resolve")
  (list "ChinaMax" "ChinaMax/ChinaMax_Classical_No_Resolve")
}}
{{- range $r := $rules }}
  {{ index $r 0 }}:
    type: http
    behavior: classical
    format: yaml
    url: {{ $rp }}/{{ index $r 1 }}.yaml
    interval: 86400
{{- end }}
